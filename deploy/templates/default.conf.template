# Gerado na subida do container a partir das variáveis de ambiente (envsubst).
# Um app só: ${CENTRAL_HOST} tem a landing page (/), o orçamento (/orcamento), a central da Vortex (/master)
# e o redirecionador das plaquinhas (/t/CODIGO); qualquer outro subdomínio é a página
# e o painel de um restaurante.

# Central
server {
  listen 80;
  server_name ${CENTRAL_HOST};
  include /etc/nginx/snippets/comum.conf;

  # Landing page (apresentação completa) e o orçamento (simulador de preços).
  location = / {
    try_files /lp/index.html =404;
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/seguranca.conf;
  }
  location ~ ^/orcamento/?$ {
    try_files /lp/orcamento.html =404;
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/seguranca.conf;
  }
  # Endereço antigo da página de preços.
  location ~ ^/precos/?$ {
    return 301 /orcamento;
  }

  # Central da Vortex (painel interno).
  location ~ ^/master/?$ {
    try_files /central/index.html =404;
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/seguranca.conf;
  }
}

# Restaurantes (subdomínios) e qualquer outro endereço
server {
  listen 80 default_server;
  server_name _;
  include /etc/nginx/snippets/comum.conf;
}
